PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Hostinger MySQL connection ---
# Find these in hPanel → Databases → MySQL Databases.
# If your Node app runs somewhere other than Hostinger itself (your own machine, a VPS,
# etc.), you must first enable remote access: hPanel → Databases → Remote MySQL →
# add the IP address of the server that will run this backend. Hostinger's shared
# hosting does not allow remote MySQL access from an unlisted IP.
DB_HOST=srv123.hostinger.com
DB_PORT=3306
DB_USER=u123456789_dbuser
DB_PASSWORD=your_database_password
DB_NAME=u123456789_khatabook
# Leave DB_SSL unset/false unless you've set up SSL for the database on Hostinger's side.
DB_SSL=false

# Default admin account created on first run (via `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
# Optional but needed if you want to log in to this account via phone+OTP too.
SEED_ADMIN_PHONE=+919876543210

# --- Email OTP login ---
# Used to send the one-time login code by email. Three options below, tried in this
# order: Hostinger Mail API → Brevo → plain SMTP. Set only the one you're using.
#
# OPTION 1 (uses your existing Hostinger mailbox, no third-party account needed):
# Hostinger's own Mail API — HTTPS-based like Brevo below, so it isn't affected by
# Hostinger's Node app hosting blocking outbound SMTP ports. Set up in hPanel:
# Emails → your domain → Agentic mail → API access → Create API token.
# HOSTINGER_MAILBOX_ADDRESS is just the mailbox's email address — the backend looks
# up its internal ID automatically via the API, so you never need to hunt for any
# opaque resource ID by hand.
# If HOSTINGER_MAIL_API_TOKEN is set, it's used automatically, before Brevo or SMTP.
APP_NAME=Led Book
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ADDRESS=noreply@yourdomain.com

# OPTION 2: Brevo (free HTTP API — https://www.brevo.com, no card needed).
# Many Node.js app hosting platforms (Hostinger's Node app hosting included, plus
# Render/Railway/Vercel and others) block outbound SMTP ports (465/587) to prevent
# spam, which makes SMTP below fail with errors like "Greeting never received" even
# though the credentials are correct. Brevo sends over plain HTTPS instead, which is
# never blocked. Sign up free, verify a sender email (Senders & IP → Senders), and
# create an API key (SMTP & API → API Keys). Free tier: 300 emails/day.
# Used automatically if set and HOSTINGER_MAIL_API_TOKEN above is not.
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@yourdomain.com

# OPTION 3: plain SMTP.
# Only used if neither option above is set. Works fine for local development or a
# VPS, but may fail on Hostinger's Node app hosting for the reason explained above —
# if you see "Failed to send OTP email" in Hostinger's Runtime logs, switch to
# option 1 or 2. Easiest SMTP source: a free mailbox on your Hostinger hosting plan
# (hPanel → Emails → Create email account).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
# true only if SMTP_PORT is 465, false for 587/25
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_account_password
# Optional — defaults to SMTP_USER if not set. Also used as Brevo's "from" if
# BREVO_FROM_EMAIL above is left blank.
SMTP_FROM=noreply@yourdomain.com
